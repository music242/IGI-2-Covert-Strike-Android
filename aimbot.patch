+    /// <summary>How far an aimbot target may be, in world units: 100 metres at 4096 units to the metre.</summary>
+    private const double AimbotRange = 409600.0;
+
+    /// <summary>The cosine of the widest angle off the view an aimbot target may sit at, 35 degrees.</summary>
+    private const double AimbotConeCosine = 0.81915204;
+
+    /// <summary>How far below a standing soldier's eyes the aimbot aims, in world units: about a tenth of a metre.</summary>
+    private const double AimbotHeadDrop = 400.0;
+
+    /// <summary>
+    /// The aimbot cheat: finds the living soldier nearest the line of sight, within <see cref="AimbotRange"/> and the
+    /// <see cref="AimbotConeCosine"/> cone, and gives the orientation that looks at its head.
+    /// </summary>
+    /// <param name="orientation">The nine cells of the orientation, row by row, when a target is found.</param>
+    /// <returns><see langword="true"/> when a target was found.</returns>
+    /// <remarks>
+    /// The view looks along its orientation's second column (<c>Retract</c> and the fire frame use it as forward) with Z up;
+    /// <c>EngineEuler.Rotation(alpha, 0, gamma)</c> looks along (-cos(alpha) sin(gamma), cos(alpha) cos(gamma), sin(alpha)),
+    /// so a direction d is turned back into alpha = atan2(dz, |dxy|) and gamma = atan2(-dx, dy). There is no line-of-sight
+    /// test: a soldier behind a wall is still aimed at.
+    /// </remarks>
+    private bool TryAimbotOrientation(out float[] orientation)
+    {
+        orientation = [];
+        Matrix3f view = View.Orientation;
+        double fx = view.M12, fy = view.M22, fz = view.M32;
+        double forwardLength = Math.Sqrt((fx * fx) + (fy * fy) + (fz * fz));
+        if (forwardLength < 1e-6)
+        {
+            return false;
+        }
+
+        fx /= forwardLength;
+        fy /= forwardLength;
+        fz /= forwardLength;
+
+        Vector3d from = View.Position;
+        double bestCosine = AimbotConeCosine;
+        double bestX = 0, bestY = 0, bestZ = 0;
+        bool found = false;
+        foreach (Igi2Human human in Surroundings.Humans)
+        {
+            if (human is not Soldiers.Igi2HumanSoldier || human.IsDead)
+            {
+                continue;
+            }
+
+            Vector3d eyes = EyesAt(human.Position, human.Pose);
+            double dx = eyes.X - from.X;
+            double dy = eyes.Y - from.Y;
+            double dz = eyes.Z - AimbotHeadDrop - from.Z;
+            double distance = Math.Sqrt((dx * dx) + (dy * dy) + (dz * dz));
+            if (distance < 1.0 || distance > AimbotRange)
+            {
+                continue;
+            }
+
+            double cosine = ((dx * fx) + (dy * fy) + (dz * fz)) / distance;
+            if (cosine > bestCosine)
+            {
+                bestCosine = cosine;
+                bestX = dx / distance;
+                bestY = dy / distance;
+                bestZ = dz / distance;
+                found = true;
+            }
+        }
+
+        if (!found)
+        {
+            return false;
+        }
+
+        float alpha = (float)Math.Atan2(bestZ, Math.Sqrt((bestX * bestX) + (bestY * bestY)));
+        float gamma = (float)Math.Atan2(-bestX, bestY);
+        orientation = EngineEuler.Rotation(alpha, 0f, gamma);
+        return true;
+    }
